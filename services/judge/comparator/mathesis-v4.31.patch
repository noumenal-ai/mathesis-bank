   if ← getNanodaEnabled then
     -- TODO: fix when nanoda fixes its string handling
-    let mut additional := #[``Nat, ``String, ``String.mk, ``Char, ``Char.ofNat, ``List]
+    let mut additional : Array Lean.Name := #[]
