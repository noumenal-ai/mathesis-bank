diff --git a/Comparator/Util.lean b/Comparator/Util.lean
index 131a070..61273d5 100644
--- a/Comparator/Util.lean
+++ b/Comparator/Util.lean
@@ -7,11 +7,33 @@ import Lean.Environment
 
 namespace Comparator
 
+/-- The constants an expression depends on: those `Expr.getUsedConstants` returns, and the
+structure named by every `Expr.proj` node, which it omits. A statement reaching a structure
+only through a projection would otherwise leave that structure uncompared, and a solution
+could redefine it (leanprover/comparator#68, backported to v4.31 for Mathesis). -/
+def usedConstants (e : Lean.Expr) : Array Lean.Name := Id.run do
+  let mut out : Std.HashSet Lean.Name := Std.HashSet.ofArray e.getUsedConstants
+  let mut seen : Std.HashSet Lean.Expr := {}
+  let mut todo : Array Lean.Expr := #[e]
+  while todo.size > 0 do
+    let x := todo.back!
+    todo := todo.pop
+    if seen.contains x then continue
+    seen := seen.insert x
+    match x with
+    | .proj s _ b => out := out.insert s; todo := todo.push b
+    | .app f a => todo := todo.push f |>.push a
+    | .lam _ t b _ | .forallE _ t b _ => todo := todo.push t |>.push b
+    | .letE _ t v b _ => todo := todo.push t |>.push v |>.push b
+    | .mdata _ b => todo := todo.push b
+    | _ => pure ()
+  return out.toArray
+
 def runForUsedConsts [Monad m] (info : Lean.ConstantInfo) (f : Lean.Name → m Unit) : m Unit := do
-  info.type.getUsedConstants.forM f
+  (usedConstants info.type).forM f
   f info.name
   if let some val := info.value? (allowOpaque := true) then
-    val.getUsedConstants.forM f
+    (usedConstants val).forM f
 
   match info with
   | .axiomInfo .. | .quotInfo .. | .defnInfo .. | .thmInfo .. | .opaqueInfo .. => return ()
@@ -23,6 +45,6 @@ def runForUsedConsts [Monad m] (info : Lean.ConstantInfo) (f : Lean.Name → m U
   | .recInfo info =>
     info.rules.forM fun rule => do
       f rule.ctor
-      rule.rhs.getUsedConstants.forM f
+      (usedConstants rule.rhs).forM f
 
 end Comparator
