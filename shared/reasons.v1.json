      "message_template": "Source is {bytes} bytes; the limit is {limit}."
    },
    {
      "code": "SOURCE_NOT_UTF8",
      "stage": "precheck",
      "terminal_state": "rejected",
      "retryable": false,
      "producer": "gateway",
      "params": ["offset"],
      "message_template": "Source is not UTF-8 at byte {offset}."
    },
    {
      "code": "PRELUDE_MODIFIED",
      "stage": "precheck",
      "terminal_state": "rejected",
      "retryable": false,
      "producer": "gateway",
