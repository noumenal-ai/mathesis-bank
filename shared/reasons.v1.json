{
  "version": 1,
  "stages": ["precheck", "build", "export", "replay", "axioms", "statement", "triviality", "closure", "assemble", "degraded", "infra"],
  "precedence": ["infra", "replay", "axioms", "statement", "triviality", "closure", "assemble"],
